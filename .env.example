# Supabase Configuration (Optional for local testing, required for live Supabase persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Store Info
NEXT_PUBLIC_STORE_NAME="Creed Perfumes"
NEXT_PUBLIC_PHONE="+213 550 12 34 56"
NEXT_PUBLIC_WHATSAPP="213550123456"
NEXT_PUBLIC_INSTAGRAM="creed_perfumes_dz"
NEXT_PUBLIC_TIKTOK="creed_perfumes_algeria"

# Telegram Store Manager Bot (server-side only; rotate any token previously used in a public build)
TELEGRAM_BOT_TOKEN="your-rotated-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_IDS="your-admin-chat-id"

# Telegram webhook RPC secret — must also be set in Supabase via:
#   ALTER DATABASE postgres SET app.telegram_bot_secret = 'same-value-here';
TELEGRAM_BOT_SECRET="your-secure-random-secret"

# Set this as Telegram's webhook secret_token and as a private Netlify variable.
TELEGRAM_SECURITY_SECRET="a-different-secure-random-secret"

# Netlify Build Hook (auto-rebuild when products change) — create in Netlify dashboard
NETLIFY_BUILD_HOOK_URL=""

# Supabase Service Role Key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# Ad Tracking & Analytics (Optional)
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
